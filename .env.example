# Ombuds environment.
#
# Copy this to .env and fill it in. Never commit the real .env: it is in .gitignore for a
# reason, and everything below except the NEXT_PUBLIC key is a server side secret.
#
# web/.env.local is a symlink to the root .env so Next.js and the deploy scripts read the
# same file and cannot drift apart.

# Neon Postgres. The search index only, never the source of truth for a verdict.
DATABASE_URL=

# Privy, email sign in only. The secret is server side and must never be exposed.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The one value the browser is allowed to see.
NEXT_PUBLIC_PRIVY_APP_ID=

# The relayer key. Holds no user funds. It signs chain writes on a member's behalf so
# nobody filing an appeal ever sees a wallet, a seed phrase or a gas prompt.
RELAYER_PRIVATE_KEY=

# The key used by deploy/deploy.mjs. Can be the same as the relayer in development.
DEPLOYER_KEY=

# GenLayer studio network.
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Filled in by deploy/deploy.mjs once the contracts are on chain.
PLAN_REGISTRY_ADDRESS=
OMBUDS_COURT_ADDRESS=
ADVANCE_POOL_ADDRESS=
